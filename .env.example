# Environment Configuration Template for Previa (PVFC)

# Environment
ENVIRONMENT=development
LOG_LEVEL=info

# Database (PostgreSQL)
POSTGRES_USER=pvfc_admin
POSTGRES_PASSWORD=pvfc_secret_pass
POSTGRES_DB=pvfc_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pvfc_admin:pvfc_secret_pass@localhost:5432/pvfc_db

# Backend API
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
PORT=3000

# AI / OCR / LLM (Optional / Mocked by default)
OCR_ENGINE=tesseract
OPENAI_API_KEY=mock-or-optional-key
